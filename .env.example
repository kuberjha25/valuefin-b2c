# Copy to .env.local for local work, and set the same names in your host (Vercel, Netlify, your server).

# Public address of the site. Used for canonical URLs, the sitemap, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://valuefin.in

# Where form submissions go (server side). Any endpoint that accepts a JSON POST:
# a CRM webhook, Zapier, Make, n8n, a Google Apps Script web app, a Slack or Teams workflow.
# While this is empty and NEXT_PUBLIC_FORM_ENDPOINT is empty, both forms run in demo mode
# (they validate and show the thank-you message but send nothing) and show a visible demo note.
LEAD_WEBHOOK_URL=
# Optional secret, sent to the webhook as the X-Webhook-Token header
LEAD_WEBHOOK_TOKEN=

# Static hosting only (output: 'export', no server): a form service address the browser posts to directly.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional search engine verification codes (the content value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
