# Copy to .env.local for local work, and set the same names in your host (Vercel, Netlify, your server).

# Public address of the site. Used for canonical URLs, the sitemap, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://valuefin.in






# Email every form submission over SMTP (server side). Works with Gmail / Google Workspace,
# Zoho Mail, Microsoft 365, Amazon SES, Brevo, Mailgun, your host's mail server, and so on.
# Setting SMTP_HOST and MAIL_TO turns it on. Can be used alone or together with LEAD_WEBHOOK_URL.
SMTP_HOST=smtp.rediffmailpro.com
# 465 = TLS from the start, 587 = STARTTLS (most common). SMTP_SECURE is worked out from the port if left empty.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kuber.jha@chaupal.in
# For Gmail / Google Workspace this must be an App Password, not the normal account password.
SMTP_PASS='Email Password'
# Sender shown on the email. Bare address or "Name <address>". Usually must match SMTP_USER or a verified sender.
# Defaults to "Valuefin website" <SMTP_USER>.
MAIL_FROM=
# Who receives the submissions. Comma-separate several addresses.
MAIL_TO=hello@valuefin.in
# Optional copy
MAIL_CC=
# Optional: the name this site gives when greeting the mail server. Defaults to the domain of SMTP_USER.
SMTP_HELO_NAME=

# Where form submissions go (server side). Any endpoint that accepts a JSON POST:
# a CRM webhook, Zapier, Make, n8n, a Google Apps Script web app, a Slack or Teams workflow.
# While this is empty and NEXT_PUBLIC_FORM_ENDPOINT is empty, both forms run in demo mode
# (they validate and show the thank-you message but send nothing) and show a visible demo note.
LEAD_WEBHOOK_URL=
# Optional secret, sent to the webhook as the X-Webhook-Token header
LEAD_WEBHOOK_TOKEN=

# Static hosting only (output: 'export', no server): a form service address the browser posts to directly.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional search engine verification codes (the content value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
